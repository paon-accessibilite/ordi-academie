{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ordi Academie",
  "version": "0.3.1",
  "identifier": "fr.paon.ordi-academie",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ordi Academie",
        "width": 1280,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 600,
        "fullscreen": true,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Apprendre à utiliser un ordinateur, pas à pas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "PAON"
      }
    },
    "publisher": "PAON",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../INSTALLATION-WINDOWS.md": "LIRE-MOI-WINDOWS.md"
    }
  }
}
